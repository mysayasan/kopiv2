{
  "jwt": {
    "secret": ""
  },
  "loginSecurity": {
    "enabled": true,
    "maxAttempts": 5,
    "windowSeconds": 300,
    "lockoutSeconds": 60,
    "lockoutMaxSeconds": 900,
    "failedDelayMs": 500,
    "notifyOnLockout": true
  },
  "localAuth": {
    "enabled": true,
    "username": "admin",
    "password": "admin123"
  },
  "pairing": {
    "enabled": true,
    "multicastAddr": "239.255.90.21:49531",
    "replayWindowSeconds": 30,
    "mtlsPort": 39532,
    "controlPort": 39533,
    "mediaPort": 39534,
    "certTtlHours": 168,
    "renewBeforeHours": 48,
    "heartbeatIntervalSeconds": 60
  },
  "notification": {
    "webhook": {
      "enabled": false,
      "url": "",
      "minSeverity": "warning"
    },
    "telegram": {
      "enabled": false,
      "botToken": "",
      "chatId": "",
      "minSeverity": "warning"
    },
    "sseClientBuffer": 16,
    "retentionDays": 30,
    "purgeIntervalHours": 6,
    "purgeReadOnly": false
  },
  "fileStorage": {
    "path": "./uploads",
    "cleanup": {
      "enabled": false,
      "frequencySeconds": 60,
      "batchSize": 100
    }
  },
  "cache": {
    "provider": "default",
    "ttlSeconds": 30,
    "keyPrefix": "kopiv2",
    "redis": {
      "address": "localhost:6379",
      "password": "Simpnify@123",
      "db": 0,
      "useTls": false,
      "connectTimeoutMs": 2000,
      "operationTimeoutMs": 2000
    }
  },
  "rateLimit": {
    "enabled": true,
    "endpointCacheTtlSeconds": 30,
    "defaultWindowSeconds": 60,
    "devOnly": {
      "enabled": true,
      "requests": 300,
      "windowSeconds": 60
    },
    "authOnly": {
      "enabled": true,
      "requests": 120,
      "windowSeconds": 20
    },
    "public": {
      "enabled": true,
      "requests": 30,
      "windowSeconds": 60
    }
  },
  "transaction": {
    "lockProvider": "memory",
    "lockWaitTimeoutMs": 30000,
    "lockLeaseMs": 10000,
    "operationTimeoutMs": 30000,
    "stuckTimeoutMs": 30000,
    "jobWorkerEnabled": false,
    "jobWorkerFrequencySeconds": 5,
    "maxAttempts": 3
  },
  "logging": {
    "enabled": true,
    "path": "./logs/myiotsan.log",
    "maxLineBytes": 8192,
    "cleanup": {
      "enabled": false,
      "maxRetentionDays": 90,
      "frequencyMinutes": 60
    }
  },
  "apiLog": {
    "cleanup": {
      "enabled": false,
      "maxRetentionDays": 90,
      "frequencyMinutes": 60
    }
  },
  "telemetry": {
    "enabled": true,
    "prometheus": {
      "enabled": true,
      "metricsPath": "/metrics",
      "apiDurationThresholdMs": 1000
    }
  },
  "tls": {
    "certPath": "./certs/cert.pem",
    "keyPath": "./certs/key.pem"
  },
  "server": {
    "hostnames": [
      "*"
    ],
    "tlsPorts": [
      3003
    ],
    "nonTlsPorts": [],
    "readHeaderTimeoutSeconds": 5,
    "readTimeoutSeconds": 0,
    "writeTimeoutSeconds": 0,
    "idleTimeoutSeconds": 120
  },
  "allowOrigins": "https://192.168.1.50",
  "securityHeaders": {
    "contentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "bootstrap": {
    "enabled": true,
    "autoCreateDatabase": true,
    "autoCreateSchema": true,
    "autoMigrate": true,
    "autoSeed": true,
    "allowReset": true,
    "setupPath": "/setup",
    "seedStatements": []
  },
  "db": {
    "engine": "sqlite",
    "host": "",
    "port": 0,
    "user": "",
    "password": "",
    "db_name": "./data/myiotsan.db",
    "ssl_mode": ""
  }
