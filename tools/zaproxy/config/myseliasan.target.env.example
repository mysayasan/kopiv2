# Copy this file to myseliasan.target.env and fill in your values.
# myseliasan.target.env is git-ignored so your credentials never hit the repo.

# Base URL of the running myseliasan instance, as reachable FROM the ZAP
# container. On Docker Desktop (Windows/Mac) the host is host.docker.internal.
# myseliasan serves TLS on port 3002 with a self-signed cert (ZAP ignores it).
TARGET=https://host.docker.internal:3002

# Local (stock-superadmin) credentials. myseliasan authenticates via
# POST /api/auth/local-login {username,password} — NOT HTTP Basic — so the ZAP
# plans use JSON authentication + cookie session management with these.
# Leave both blank to scan only the anonymous surface (which, for myseliasan,
# just redirects to the SSO provider — so authenticated is strongly preferred).
#
# The seeded stock superadmin defaults to admin/admin and is flagged
# must-change-password on first login. Clear that flag first (POST
# /api/auth/change-password, or just log in once through the UI) and put the
# resulting password here, otherwise authenticated coverage is limited.
ZAP_AUTH_USER=admin
ZAP_AUTH_PASS=
