# Copy this file to myidsan.target.env and fill in your values.
# myidsan.target.env is git-ignored so your credentials never hit the repo.

# Base URL of the running myidsan instance, as reachable FROM the ZAP container. On
# Docker Desktop (Windows/Mac) the host is host.docker.internal. myidsan serves TLS on
# port 3001 with a self-signed cert (ZAP ignores it).
TARGET=https://host.docker.internal:3001

# Local superadmin credentials. myidsan authenticates via
# POST /api/login/default {username,password} — its own path, NOT myseliasan's
# /api/auth/local-login and NOT myiotsan's /api/auth/login — so the plans use JSON
# authentication + cookie session management with these.
# Leave both blank to scan only the anonymous surface (the login page and the
# authorize/token endpoints), which is still worth a baseline pass.
#
# There is no shipped default password: the bootstrap superadmin's password is generated
# per install and written to INITIAL_ADMIN_LOGIN.txt in the data dir (also in the startup
# log). The account is flagged must-change-password on first login — clear that flag
# first (sign in once, or POST /api/login/default/change-password) and put the RESULTING
# password here. While the flag is set, login succeeds but every other authenticated
# endpoint returns 401 password_change_required and the scan finds almost nothing.
ZAP_AUTH_USER=admin
ZAP_AUTH_PASS=

# --- Before an api/full run, on the THROWAWAY target only ---------------------------
#
# Rate limiting: shipped enabled. An active scan trips it immediately and the run becomes
# a wall of 429s that look like the app rejecting attacks. Start the target with
# rateLimit.enabled=false.
#
# Failed-login lockout: myidsan locks out per IP *and* per account. An active scanner
# hammering /api/login/default will lock the scanning account out within seconds and the
# rest of the run is unauthenticated. Set loginSecurity.enabled=false on the throwaway.
#
# Both of these are security features working correctly — turning them off is what makes
# the scan able to reach the code behind them. Never do it on anything but a throwaway.
