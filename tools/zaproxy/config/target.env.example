# Copy this file to target.env and fill in your values.
# target.env is git-ignored so your credentials never hit the repo.

# Base URL of the running mymatasan instance, as reachable FROM the ZAP
# container. On Docker Desktop (Windows/Mac) the host is host.docker.internal.
# mymatasan serves TLS on port 3000 with a self-signed cert (ZAP ignores it).
TARGET=https://host.docker.internal:3000

# HTTP Basic credentials of a mymatasan user to scan authenticated surface.
# Leave both blank to scan only the anonymous/unauthenticated surface.
# The initial admin login is in apps/mymatasan/INITIAL_ADMIN_LOGIN.txt.
ZAP_AUTH_USER=admin
ZAP_AUTH_PASS=
