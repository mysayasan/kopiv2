# Copy this file to myiotsan.target.env and fill in your values.
# myiotsan.target.env is git-ignored so your credentials never hit the repo.

# Base URL of the running myiotsan instance, as reachable FROM the ZAP container. On
# Docker Desktop (Windows/Mac) the host is host.docker.internal. myiotsan serves TLS on
# port 3003 with a self-signed cert (ZAP ignores it).
TARGET=https://host.docker.internal:3003

# Local (stock-superadmin) credentials. myiotsan authenticates via
# POST /api/auth/login {username,password} — NOT HTTP Basic, and NOT myseliasan's
# /api/auth/local-login (myiotsan is on the appliance local-auth stack) — so the ZAP plans
# use JSON authentication + cookie session management with these.
# Leave both blank to scan only the anonymous surface, which is just the login page.
#
# There is deliberately NO shipped default password (this appliance can actuate relays):
#   dev (config.dev.json) : admin123
#   packaged install      : generated per install — see INITIAL_ADMIN_LOGIN.txt in the
#                           data dir, or the startup log
#   either                : LOCAL_ADMIN_PASSWORD overrides both
#
# The account is flagged must-change-password on first login. Clear that flag first (log in
# once through the UI, or POST /api/auth/change-password) and put the RESULTING password
# here, otherwise authenticated coverage is limited.
ZAP_AUTH_USER=admin
ZAP_AUTH_PASS=

# Rate limiting: the shipped config enables it, and an active scan trips it immediately —
# which shows up as a wall of 429s that look like the app rejecting the attacks. Start the
# throwaway target with rateLimit.enabled=false (or RATE_LIMIT_ENABLED=false) before an
# api/full run, or the findings are meaningless.
