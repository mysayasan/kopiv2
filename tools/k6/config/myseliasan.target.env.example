# Copy to config/myseliasan.target.env and fill in. Read by run.ps1/run.sh when
# invoked with -App myseliasan. config/myseliasan.target.env is git-ignored.

# How the k6 CONTAINER reaches the app. On Docker Desktop the host is
# host.docker.internal. myseliasan dev listens on TLS :3002.
BASE_URL=https://host.docker.internal:3002

# A myseliasan user for the authenticated surface. myseliasan authenticates via
# POST /api/auth/local-login {username,password} (NOT HTTP Basic) and then rides
# a cookie session, so k6 logs in ONCE per VU and reuses the session cookie.
# Leave blank for an anonymous run (only public endpoints will 2xx).
#
# The stock superadmin's password depends on how the target was started — there is
# NO admin/admin fallback (it was removed; a fleet control plane must not ship a
# guessable default):
#   dev (config.dev.json) : admin123
#   packaged install      : generated per install — see INITIAL_ADMIN_LOGIN.txt in
#                           the data dir, or the startup log
#   either                : LOCAL_ADMIN_PASSWORD overrides both
#
# The account is flagged must-change-password on first login. IMPORTANT: while that
# flag is set, login succeeds and /api/session/me works, but every OTHER authed
# endpoint returns 401 password_change_required — so the load scripts can't read
# anything. Clear it first (log in once through the UI, or POST
# /api/auth/change-password) and put the RESULTING password here.
AUTH_USER=admin
AUTH_PASS=
