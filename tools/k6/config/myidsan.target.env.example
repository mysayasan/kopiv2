# Copy this file to myidsan.target.env and fill in your values.
# myidsan.target.env is git-ignored so your credentials never hit the repo.

# Base URL of the running myidsan instance. myidsan serves TLS on port 3001 with a
# self-signed cert (the scripts set insecureSkipTLSVerify).
BASE_URL=https://host.docker.internal:3001

# Superadmin credentials. myidsan authenticates via POST /api/login/default
# {username,password} — its own path, not myseliasan's /api/auth/local-login and not
# myiotsan's /api/auth/login.
#
# The bootstrap password is generated per install and written to INITIAL_ADMIN_LOGIN.txt
# in the data dir. The account is flagged must-change-password on first login: while that
# flag is set, login succeeds but every other authenticated endpoint returns 401
# password_change_required, so the smoke script fails every check for a reason that has
# nothing to do with load. Sign in once to clear it and put the RESULTING password here.
AUTH_USER=admin
AUTH_PASS=

# --- Before any run against a throwaway instance -------------------------------------
#
# Turn OFF the failed-login lockout (loginSecurity.enabled=false) and the rate limiter
# (rateLimit.enabled=false). myidsan locks out per IP *and* per account, so repeated
# logins from the load generator are exactly the pattern it exists to stop — leave it on
# and the run measures the lockout instead of the app.
#
# This matters most for `-Script stress -e MODE=login`, where every single iteration is a
# fresh sign-in. That mode is the one worth running on an identity provider: it measures
# bcrypt throughput, which is an order of magnitude lower than read throughput and is what
# a Monday-morning login storm actually hits. Sizing the box from the read numbers alone
# will be wrong.
