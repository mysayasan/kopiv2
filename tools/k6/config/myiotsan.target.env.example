# Copy to config/myiotsan.target.env and fill in. Read by run.ps1/run.sh when
# invoked with -App myiotsan. config/myiotsan.target.env is git-ignored.

# How the k6 CONTAINER reaches the app. On Docker Desktop the host is
# host.docker.internal. myiotsan dev listens on TLS :3003.
BASE_URL=https://host.docker.internal:3003

# A myiotsan user for the authenticated surface. myiotsan authenticates via
# POST /api/auth/login {username,password} (NOT HTTP Basic, and NOT myseliasan's
# /api/auth/local-login) and then rides a cookie session, so k6 logs in ONCE per
# VU and reuses the session cookie. That means bcrypt runs once per VU rather than
# once per request — unlike mymatasan, the KDF is not the ceiling here.
# Leave blank for an anonymous run (only public endpoints will 2xx).
#
# The stock superadmin's password depends on how the target was started — there is
# deliberately NO shipped default (this appliance can actuate relays):
#   dev (config.dev.json) : admin123
#   packaged install      : generated per install — see INITIAL_ADMIN_LOGIN.txt in
#                           the data dir, or the startup log
#   either                : LOCAL_ADMIN_PASSWORD overrides both
#
# The account is flagged must-change-password on first login. IMPORTANT: while that
# flag is set, login succeeds but the other authed endpoints refuse to serve — so
# the load scripts can't read anything. Clear it first (log in once through the UI,
# or POST /api/auth/change-password) and put the RESULTING password here.
AUTH_USER=admin
AUTH_PASS=

# NOTE ON SCOPE: these scripts exercise the HTTP console only. myiotsan's real
# throughput question — hundreds of sensors publishing to the embedded MQTT broker,
# deadband-gated, batched into SQLite — is not something k6 can drive. Pair a green
# run here with an actual MQTT publish test before believing the box is sized right.
