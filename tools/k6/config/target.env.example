# Copy to config/target.env and fill in. Both files are read by run.ps1/run.sh.
# config/target.env is git-ignored.

# How the k6 CONTAINER reaches the app. On Docker Desktop the host is
# host.docker.internal. mymatasan dev listens on TLS :3000.
BASE_URL=https://host.docker.internal:3000

# A mymatasan user for the authenticated surface. HTTP Basic — the SPA replays
# this on every request, so k6 does the same. Leave blank for an anonymous run
# (only public endpoints will return 2xx). The initial admin login is in
# apps/mymatasan/INITIAL_ADMIN_LOGIN.txt (admin/admin123 on a fresh install;
# note the first sign-in forces a password change).
AUTH_USER=admin
AUTH_PASS=admin123
