# Logs
logs
*.log

#compiled files
*.exe

# generated Windows resource objects (icon + version info; produced in CI/local
# builds by goversioninfo, arch-suffixed so Go links them per-target)
cmd/mymatasan/*.syso
cmd/myseliasan/*.syso
cmd/myiotsan/*.syso
cmd/myidsan/*.syso

# goreleaser build output
/dist/
# throwaway packages built by deploy/nfpm/tests/run.sh
/.pkgtest/
/packaging/staging/
/packaging/staging-myseliasan/
/packaging/staging-myiotsan/
/packaging/staging-myidsan/

# make build output (per-app)
apps/*/bin/

#node_modules
node_modules

#env
.env

#local tools
.tools/

# mymatasan local detector artifacts
apps/mymatasan/models/.venv/
apps/mymatasan/models/__pycache__/
apps/mymatasan/models/*.pt
apps/mymatasan/models/*.onnx
apps/mymatasan/ai/__pycache__/

# throwaway local verification scaffolding (isolated test instances, drivers)
.artifacts/

# ignore recordings on the root of the project
/recordings/
/runs/

# per-app runtime recordings written while the app runs (NVR segments + AI snapshots)
apps/*/recordings/

# logs
logs/

# claude
.claude/

# local runtime sqlite databases (recreated by bootstrap; may hold secrets like the fleet CA key)
apps/*/data/*.db
apps/*/data/*.db-shm
apps/*/data/*.db-wal

# offline map basemap archives — large (~200MB+) provisioned assets, not source.
# Generated out-of-band with `pmtiles extract` and dropped in <dataDir>/basemap (which is
# <app>/basemap in a dev checkout, since DataDir defaults to the app's home dir).
apps/*/basemap/*.pmtiles
apps/*/data/basemap/*.pmtiles

# floor-plan images written at runtime (encrypted at rest) — user data, not source.
apps/*/floorplans/
apps/*/data/floorplans/

# tgbridge (telegram bridge): config holds the bot token; state file holds session ids
tools/tgbridge/config.json
tgbridge_state.json

# encryption-at-rest runtime key material & recovery artifacts (never commit)
apps/*/secret/
secret/atrest.key
secret/atrest.key.init
*.atrestkey

# TLS keypairs. apps/*/secret/ was already ignored but apps/*/certs/ was not, so
# apps/myidsan/certs/key.pem sat in the repo as a tracked private key. Nothing needs it
# committed: ensureSelfSignedCert (infra/apphost/run.go) generates a keypair on first boot
# whenever a TLS listener is configured and the files are missing.
apps/*/certs/

# AI agent sidecar runtime artifacts (llama-server binaries + GGUF models, up to
# gigabytes). Acquired at runtime by the in-app installer/import — never committed.
apps/*/llm/
*.atrestkey.applied

# GitHub CLI local machine state (device-id etc.); not project data
.local/
tools/tgbridge/outbox/
tools/tgbridge/.gocache/
tools/tgbridge/go-build*/
# first-run generated admin credential (secret; regenerated per install)
INITIAL_ADMIN_LOGIN.txt
apps/*/INITIAL_ADMIN_LOGIN.txt
