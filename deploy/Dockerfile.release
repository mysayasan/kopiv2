# Runtime image for MyMataSan, consumed by GoReleaser's `dockers` builders.
# The binary is cross-compiled by GoReleaser and placed at the build-context root;
# extra_files supply the web UI, AI worker scripts, and the default config.
#
# ffmpeg (recording / transcode / live audio) is baked in. The Python AI stack
# (ultralytics/torch) and model weights are fetched at runtime, keeping the image
# lean; python3 + venv are present so that fetch has a base to install into.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# GoReleaser copies the matching-arch binary to the context root as "mymatasan".
COPY mymatasan /app/mymatasan
COPY apps/mymatasan/static /app/static
COPY apps/mymatasan/ai /app/ai
COPY deploy/dist/config.json /app/config.json

# Read-only app home vs writable data dir (mount a volume at /data to persist
# the database, recordings, logs, and the encryption key).
ENV MYMATASAN_HOME=/app \
    MYMATASAN_DATA=/data \
    KOPIV2_SUPERVISED=1
VOLUME ["/data"]

EXPOSE 3000

ENTRYPOINT ["/app/mymatasan"]
