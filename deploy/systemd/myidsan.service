# systemd unit for MyIDSan (Linux) — the identity provider / SSO hub for the suite.
#
# Install:
#   sudo cp deploy/systemd/myidsan.service /etc/systemd/system/
#   # edit WorkingDirectory/ExecStart/User below to match your install
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now myidsan
#   journalctl -u myidsan -f      # view logs (the first-run admin password lands here)
#
# Restart=always + KOPIV2_SUPERVISED=1 means an in-app restart exits cleanly and
# systemd relaunches it.

[Unit]
Description=MyIDSan identity provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Where config.json, the database, logs, certs and the secret/ key live:
WorkingDirectory=/opt/myidsan
ExecStart=/opt/myidsan/myidsan
Environment=KOPIV2_SUPERVISED=1
Restart=always
RestartSec=2
# Recommended: run as a dedicated unprivileged user that owns WorkingDirectory.
# User=myidsan
# Group=myidsan

[Install]
WantedBy=multi-user.target
